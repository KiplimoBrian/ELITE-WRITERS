rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "kiplagatcollins18@gmail.com" ||
          request.auth.token.email == "kuruikiplimo254@gmail.com"
        );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPaid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.paymentStatus == "paid";
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && userId == request.auth.uid);

      allow create: if isSignedIn() && userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "phone",
            "paymentStatus",
            "email",
            "createdAt",
            "updatedAt",
            "paymentMethod",
            "paymentPhone",
            "checkoutRequestId",
            "merchantRequestId",
            "paymentLastError"
          ])
          && (
            !("paymentStatus" in request.resource.data)
            || request.resource.data.paymentStatus in ["pending", "unpaid"]
          )
        );

      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isAdmin() || isPaid();
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if isPaid()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.jobDocId is string
        && request.resource.data.status in ["pending", "applied"]
        && request.resource.data.appliedAt is timestamp;

      allow read: if isAdmin()
        || (isPaid() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if isPaid()
        && request.resource.data.writerId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.writerEmail is string
        && request.resource.data.status == "submitted"
        && request.resource.data.submittedAt is timestamp;

      allow read: if isAdmin()
        || (isPaid() && resource.data.writerId == request.auth.uid);

      allow update: if isAdmin()
        || (
          isPaid()
          && resource.data.writerId == request.auth.uid
          && request.resource.data.writerId == resource.data.writerId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "files",
            "submissionNote",
            "updatedAt",
            "correctionResubmittedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    match /registration_payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isPaid()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin()
        || (isPaid() && resource.data.uid == request.auth.uid);

      allow update, delete: if isAdmin();
    }
  }
}